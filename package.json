{
  "name": "expenses",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "mcp:build": "cd mcp-server && npm run build",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:start": "cd mcp-server && npm start",
    "mcp:secret": "bash scripts/setup-mcp-secret.sh",
    "mcp:deploy": "bash scripts/deploy-mcp-cloud-run.sh",
    "watch": "ng build --watch --configuration development",
    "pp": "ng build && mv docs/browser/* docs && git add . && git commit -m 'feat: build' && git push origin HEAD",
    "ppwin": "ng build && Move-Item docs/browser/* docs && git add . && git commit -m 'feat: build' && git push origin HEAD",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,js,json}\"",
    "android:build-web": "ng build --configuration android && if [ -d docs/browser ]; then mv docs/browser/* docs && rmdir docs/browser; fi",
    "android:prepare": "bash android-webview/copy-web.sh",
    "android:apk": "npm run android:build-web && npm run android:prepare && (cd android-webview && ./gradlew assembleDebug)",
    "android:install": "(cd android-webview && ./gradlew installDebug)",
    "pwa:preview:prod": "ng build && if [ -d docs/browser ]; then mv docs/browser/* docs && rmdir docs/browser; fi && node scripts/adjust-base.js && node scripts/pwa-preview-prod.cjs",
    "pwa:preview:local": "ng build --configuration android && if [ -d docs/browser ]; then mv docs/browser/* docs && rmdir docs/browser; fi && npx http-server docs -c-1 --port 5173 --fallback index.html",
    "icons:gen": "node scripts/generate-icons.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@fortawesome/angular-fontawesome": "^0.15.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@types/hammerjs": "^2.0.45",
    "chart.js": "^4.4.4",
    "echarts": "^5.5.1",
    "firebase": "^10.13.2",
    "hammerjs": "^2.0.8",
    "luxon": "^3.5.0",
    "ng2-charts": "^6.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^10.0.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/luxon": "^3.4.2",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright": "^1.61.1",
    "prettier": "3.6.2",
    "sharp": "^0.33.5",
    "typescript": "~5.5.2"
  }
}
